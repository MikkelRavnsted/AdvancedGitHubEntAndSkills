{
  "$schema": "https://json.schemastore.org/mcp-servers",
  "comment": "Example MCP configuration for VS Code (workspace-level)",
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./docs"],
      "description": "Read-only access to project documentation"
    },
    "fetch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "Fetch and read web pages for reference documentation"
    }
  }
}
